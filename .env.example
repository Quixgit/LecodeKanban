# Copy to .env and fill in. Never commit .env. Values with spaces or <> must be quoted.
# Generate secrets with: openssl rand -base64 48 (secret key) / openssl rand -base64 32 (encryption key)

# development | production | test
LK_ENV=development
# debug | info | warn | error
LK_LOG_LEVEL=info

# --- Network (public IP + non-standard ports, docs/adr/0004) ---
LK_PUBLIC_HOST=23.19.228.158
# browser-facing origin (links in emails, OAuth callbacks)
LK_PUBLIC_URL=http://23.19.228.158:47100
LK_WEB_HOST=0.0.0.0
LK_WEB_PORT=47100
# API; reached through the web proxy
LK_HTTP_ADDR=127.0.0.1:47101
# where Vite proxies /api
LK_API_URL=http://127.0.0.1:47101
# Prometheus /metrics (internal only)
LK_METRICS_ADDR=127.0.0.1:47106
# API only reachable via our proxy → trust rightmost X-Forwarded-For
LK_TRUST_PROXY=true
# extra allowed browser origins, comma-separated
LK_CORS_ORIGINS=
# true behind TLS (required in production)
LK_COOKIE_SECURE=false
# run background jobs inside the API (dev); prod uses cmd/worker
LK_EMBEDDED_WORKER=true
# uploaded files (a named volume in docker-compose.yml) and the per-file limit
LK_ATTACHMENTS_DIR=./data/attachments
LK_ATTACHMENT_MAX_MB=25

# --- Database (docker-compose.dev.yml) ---
LK_POSTGRES_PORT=47102
LK_POSTGRES_PASSWORD=change-me
LK_DATABASE_URL=postgres://lecodekanban:change-me@127.0.0.1:47102/lecodekanban?sslmode=disable

# --- Secrets ---
# ≥32 random bytes, base64 — signs access tokens & OAuth state
LK_SECRET_KEY=
# exactly 32 bytes, base64 — AES-256-GCM for integration tokens
LK_ENCRYPTION_KEY=

# --- Email ---
# smtp (Mailpit in development, or any SMTP relay) | mailgun (HTTP API)
LK_MAIL_PROVIDER=smtp
# Mailgun: verify the sending domain (SPF + DKIM DNS records) in the Mailgun dashboard first.
LK_MAILGUN_API_KEY=
LK_MAILGUN_DOMAIN=
# us | eu
LK_MAILGUN_REGION=us
# Defaults to LK_SMTP_FROM; the address must be on LK_MAILGUN_DOMAIN
LK_MAILGUN_FROM=
LK_SMTP_HOST=127.0.0.1
LK_SMTP_PORT=47104
# none | starttls | tls
LK_SMTP_TLS=none
LK_SMTP_USERNAME=
LK_SMTP_PASSWORD=
LK_SMTP_FROM="LecodeKanban <no-reply@lecodekanban.local>"
LK_MAILPIT_UI_PORT=47105
# basic auth for the Mailpit web UI (exposed on the public IP)
LK_MAILPIT_UI_AUTH=lk:change-me

# --- OAuth sign-in (optional; callback: $LK_PUBLIC_URL/api/v1/auth/oauth/<provider>/callback) ---
LK_GOOGLE_CLIENT_ID=
LK_GOOGLE_CLIENT_SECRET=
# Google Calendar integration (Integrations page) reuses the two values above. In the Google Cloud console
# enable the Google Calendar API, add the scope calendar.events.readonly to the consent screen, and register
# this redirect URI on the OAuth client:  <LK_PUBLIC_URL>/api/v1/integrations/google_calendar/callback
# LK_INTEGRATIONS_TICK=30s   # how often meetings are re-synced and reminders checked
LK_GITHUB_CLIENT_ID=
LK_GITHUB_CLIENT_SECRET=

# --- Frontend (public, embedded in the bundle — no secrets!) ---
VITE_GMAIL_INBOX_URL=https://mail.google.com/mail/u/0/#inbox
